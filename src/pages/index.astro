---
import '../styles/global.css';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Faith Family Football Ministry</title>
    <meta
      name="description"
      content="Faith Family Football Ministry builds character, faith, and community in Southwest Virginia through football, mentorship, and servant leadership."
    />
  </head>
  <body class="bg-slate-50 text-slate-900">
    <header class="sticky top-0 z-50 border-b border-slate-200/80 bg-slate-950/95 backdrop-blur">
      <div class="mx-auto flex max-w-7xl items-center justify-between px-6 py-4 lg:px-8">
        <a href="#top" class="flex items-center gap-3 text-sm font-semibold uppercase tracking-[0.3em] text-white">
          <span class="flex h-10 w-10 items-center justify-center rounded-full bg-red-700 text-lg font-black">FF</span>
          <span>Faith Family Football</span>
        </a>
        <nav class="hidden gap-6 text-sm font-medium text-slate-300 md:flex">
          <a href="#about" class="transition hover:text-white">About</a>
          <a href="#pillars" class="transition hover:text-white">Pillars</a>
          <a href="#coach" class="transition hover:text-white">Coach</a>
          <a href="#contact" class="transition hover:text-white">Contact</a>
        </nav>
      </div>
    </header>

    <main id="top">
      <section class="relative isolate overflow-hidden bg-slate-950 text-white">
        <img
          src="/image1.jpeg"
          alt="Football team huddled on the field at sunset"
          class="absolute inset-0 h-full w-full object-cover opacity-90"
        />
        <div class="absolute inset-0 bg-gradient-to-r from-slate-950 via-slate-950/70 to-slate-900/30"></div>
        <div class="relative mx-auto grid min-h-[92vh] max-w-7xl items-center gap-10 px-6 py-24 lg:grid-cols-[1.1fr_0.9fr] lg:px-8 lg:py-28">
          <div class="max-w-3xl">
            <p class="mb-4 text-sm font-semibold uppercase tracking-[0.35em] text-red-400">Southwest Virginia ministry • youth leadership</p>
            <h1 class="text-5xl font-black uppercase leading-none sm:text-6xl lg:text-7xl">
              Faith.<br /> Family.<br /> Football.
            </h1>
            <p class="mt-6 max-w-2xl text-lg leading-8 text-slate-200 sm:text-xl">
              Building character, faith, and community on and off the field through mentorship, discipline, and heart.
            </p>
            <div class="mt-8 flex flex-wrap gap-4">
              <a href="#contact" class="rounded-full bg-red-700 px-6 py-3 text-sm font-semibold uppercase tracking-[0.2em] text-white transition hover:bg-red-600">
                Get Involved
              </a>
              <a href="#pillars" class="rounded-full border border-white/30 px-6 py-3 text-sm font-semibold uppercase tracking-[0.2em] text-white transition hover:bg-white/10">
                Explore Our Mission
              </a>
            </div>
          </div>

          
        </div>
      </section>

      <section id="about" class="mx-auto max-w-7xl px-6 py-20 lg:px-8">
        <div class="grid gap-8 lg:grid-cols-[0.85fr_1.15fr] lg:items-center">
          <div>
            <p class="text-sm font-semibold uppercase tracking-[0.35em] text-red-700">About</p>
            <h2 class="mt-3 text-3xl font-black uppercase tracking-tight text-slate-950 sm:text-4xl">
              A ministry rooted in service, strength, and unity.
            </h2>
          </div>
          <div class="rounded-3xl border border-slate-200 bg-white p-8 shadow-sm">
            <p class="text-lg leading-8 text-slate-700">
              Faith Family Football Ministry exists to help youth grow into disciplined, compassionate leaders. Through football, mentorship, and faith-based encouragement, we create a welcoming environment where families feel supported and athletes learn to compete with integrity.
            </p>
          </div>
        </div>
      </section>

      <section id="pillars" class="bg-slate-950 py-20 text-white">
        <div class="mx-auto max-w-7xl px-6 lg:px-8">
          <div class="max-w-2xl">
            <p class="text-sm font-semibold uppercase tracking-[0.35em] text-red-400">The Three Pillars</p>
            <h2 class="mt-3 text-3xl font-black uppercase tracking-tight sm:text-4xl">Built on what matters most.</h2>
          </div>
          <div class="mt-12 grid gap-6 md:grid-cols-3">
            {[
              {
                title: 'Faith',
                body: 'Developing spiritual strength, integrity, and servant leadership with purpose beyond the game.',
              },
              {
                title: 'Family',
                body: 'Cultivating strong bonds, supporting parents, and building a tight-knit community around every athlete.',
              },
              {
                title: 'Football',
                body: 'Teaching discipline, toughness, teamwork, and excellence on the gridiron and in life.',
              },
            ].map((pillar) => (
              <article class="rounded-3xl border border-white/10 bg-white/10 p-8 shadow-lg backdrop-blur">
                <div class="mb-5 flex h-12 w-12 items-center justify-center rounded-full bg-red-700/90 text-white">
                  {pillar.title === 'Faith' && (
                    <svg viewBox="0 0 24 24" class="h-8 w-8" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                      <path d="M12 4v16M7 9h10" stroke-linecap="round" />
                    </svg>
                  )}
                  {pillar.title === 'Family' && (
                    <svg viewBox="0 0 24 24" class="h-7 w-7" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                      <circle cx="12" cy="7" r="2.5" />
                      <circle cx="5.5" cy="9" r="2" />
                      <circle cx="18.5" cy="9" r="2" />
                      <path d="M7.5 19c.2-3 1.8-5 4.5-5s4.3 2 4.5 5M2.5 18c.2-2.4 1.2-4 3-4 1.4 0 2.4.8 2.9 2M21.5 18c-.2-2.4-1.2-4-3-4-1.4 0-2.4.8-2.9 2" stroke-linecap="round" />
                    </svg>
                  )}
                  {pillar.title === 'Football' && (
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 500 300" class="w-full max-w-xs h-auto">
  <g fill="none" stroke="#ffffff" stroke-width="8" stroke-linecap="round" stroke-linejoin="round">
    <path d="M 100.21 150 C 170.21 30 330.912 30 400.912 150 C 330.912 270 170.21 270 100.21 150 Z" style="stroke-width: 15px;"/>
    <line x1="160" y1="150" x2="340" y2="150" style="stroke-width: 15px;"/>
    <line x1="185" y1="130" x2="185" y2="170" style="stroke-width: 15px;"/>
    <line x1="211" y1="130" x2="211" y2="170" style="stroke-width: 15px;"/>
    <line x1="237" y1="130" x2="237" y2="170" style="stroke-width: 15px;"/>
    <line x1="263" y1="130" x2="263" y2="170" style="stroke-width: 15px;"/>
    <line x1="289" y1="130" x2="289" y2="170" style="stroke-width: 15px;"/>
    <line x1="315" y1="130" x2="315" y2="170" style="stroke-width: 15px;"/>
  </g>
</svg>
                  )}
                </div>
                <h3 class="text-2xl font-bold">{pillar.title}</h3>
                <p class="mt-3 text-base leading-7 text-slate-300">{pillar.body}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section id="coach" class="mx-auto max-w-7xl px-6 py-20 lg:px-8">
        <div class="grid gap-8 rounded-[2rem] border border-slate-200 bg-white p-8 shadow-sm lg:grid-cols-[1fr_1fr] lg:p-12">
          <div class="grid gap-4 sm:grid-cols-1">
            <img src="/image0.jpeg" alt="Coach portrait in black and white" class="h-72 w-full rounded-2xl object-cover sm:h-80 lg:h-96" />
          </div>
          <div class="flex flex-col justify-center">
            <p class="text-sm font-semibold uppercase tracking-[0.35em] text-red-700">Coach Spotlight</p>
            <h2 class="mt-3 text-3xl font-black uppercase tracking-tight text-slate-950 sm:text-4xl">A leader focused on heart, growth, and guidance.</h2>
            <p class="mt-6 text-lg leading-8 text-slate-700">
              Coach brings a heart for youth, a deep love for the game, and a mission to shape young people through discipline, compassion, and bold leadership. Our ministry exists to help every player see their value both on the field and in life.
            </p>
            <div class="mt-8 flex flex-wrap gap-4">
              <a href="#contact" class="rounded-full bg-red-700 px-6 py-3 text-sm font-semibold uppercase tracking-[0.2em] text-white transition hover:bg-red-600">
                Connect With Us
              </a>
            </div>
          </div>
        </div>
      </section>

 
    </main>

    <footer id="contact" class="border-t border-slate-200 bg-slate-950 py-16 text-white">
      <div class="mx-auto grid max-w-7xl gap-10 px-6 lg:grid-cols-[1fr_0.8fr] lg:px-8">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.35em] text-red-400">Contact</p>
          <h2 class="mt-3 text-3xl font-black uppercase tracking-tight sm:text-4xl">Let’s build something strong together.</h2>
          <p class="mt-5 max-w-2xl text-lg leading-8 text-slate-300">
            Whether you are a parent, coach, church leader, or community partner, we would love to hear from you.
          </p>
        </div>
        <div class="rounded-3xl border border-white/10 bg-white/10 p-8 backdrop-blur">
          <ul class="space-y-4 text-base text-slate-200">
            <li><span class="font-semibold text-white">Email:</span> hello@faithfamilyfootballva.com</li>
            <li><span class="font-semibold text-white">Phone:</span> (757) 555-0148</li>
            <li><span class="font-semibold text-white">Social:</span> @faithfamilyfootballva</li>
          </ul>
          <p class="mt-8 text-sm text-slate-400">© 2026 faithfamilyfootballva.com</p>
        </div>
      </div>
    </footer>
  </body>
</html>
