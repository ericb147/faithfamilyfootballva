    <script>
      const samePageHashLinks = Array.from(
        document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]'),
      );

      const clearSectionHash = () => {
        history.replaceState(null, "", `${window.location.pathname}${window.location.search}`);
      };

      samePageHashLinks.forEach((link) => {
        link.addEventListener("click", (event) => {
          const href = link.getAttribute("href");
          if (!href || href === "#") {
            return;
          }

          const target = document.querySelector<HTMLElement>(href);
          if (!target) {
            return;
          }

          event.preventDefault();
          clearSectionHash();
          target.scrollIntoView({ behavior: "smooth", block: "start" });
        });
      });

      if (window.location.hash) {
        const initialTarget = document.querySelector<HTMLElement>(window.location.hash);
        if (initialTarget) {
          clearSectionHash();
          requestAnimationFrame(() => {
            window.scrollTo({ top: 0, behavior: "auto" });
          });
        }
      }

      document.addEventListener("click", (event) => {
        const openDetails = document.querySelectorAll("details[open]");

        openDetails.forEach((details) => {
          if (!details.contains(event.target as Node)) {
            details.removeAttribute("open");
          }
        });
      });

      const gallerySlides = Array.from(document.querySelectorAll<HTMLElement>("[data-gallery-slide]"));
      const galleryThumbs = Array.from(document.querySelectorAll<HTMLElement>("[data-gallery-thumb]"));
      const galleryStrip = document.getElementById("gallery-strip");
      const galleryPrev = document.getElementById("gallery-prev");
      const galleryNext = document.getElementById("gallery-next");
      let galleryIndex = 0;

      const updateGallery = (nextIndex: number) => {
        galleryIndex = (nextIndex + gallerySlides.length) % gallerySlides.length;

        gallerySlides.forEach((slide, index) => {
          const active = index === galleryIndex;
          slide.classList.toggle("opacity-100", active);
          slide.classList.toggle("opacity-0", !active);
          slide.setAttribute("aria-hidden", String(!active));
        });

        galleryThumbs.forEach((thumb, index) => {
          const active = index === galleryIndex;
          thumb.classList.toggle("ring-2", active);
          thumb.classList.toggle("ring-red-500", active);
          thumb.classList.toggle("ring-offset-2", active);
          thumb.classList.toggle("ring-offset-slate-50", active);
          thumb.setAttribute("aria-pressed", String(active));
        });
      };

      if (gallerySlides.length > 0) {
        galleryThumbs.forEach((thumb: HTMLElement) => {
          thumb.addEventListener("click", () => updateGallery(Number(thumb.dataset.index)));
        });

        galleryPrev?.addEventListener("click", () => {
          galleryStrip?.scrollBy({ left: -220, behavior: "smooth" });
          updateGallery(galleryIndex - 1);
        });

        galleryNext?.addEventListener("click", () => {
          galleryStrip?.scrollBy({ left: 220, behavior: "smooth" });
          updateGallery(galleryIndex + 1);
        });

        setInterval(() => updateGallery(galleryIndex + 1), 4000);
      }
    </script>

