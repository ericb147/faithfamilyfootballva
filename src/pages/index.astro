---
import "../styles/global.css";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/FFF.png" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Faith Family Football Ministry</title>
    <meta
      name="description"
      content="Faith Family Football Ministry builds character, faith, and community in Southwest Virginia through football, mentorship, and servant leadership."
    />
  </head>
  <body class="bg-[#f5f5f5] text-slate-900">
    <header
      class="sticky top-0 z-50 border-b border-red-600/20 bg-[#050505]/95 backdrop-blur"
    >
      <div
        class="mx-auto flex max-w-7xl items-center justify-between px-6 py-4 lg:px-8"
      >
        <a
          href="#top"
          class="flex items-center gap-3 text-sm font-semibold uppercase tracking-[0.3em] text-white"
        >
          <img
            src="/FFF.png"
            alt="Faith Family Football logo"
            class="h-15 w-15 rounded-full object-cover"
          />
          <span>Faith Family Football</span>
        </a>
        <nav class="hidden gap-6 text-sm font-medium text-white/75 md:flex">
          <a href="#about" class="transition hover:text-red-500">About</a>
          <a href="#build" class="transition hover:text-red-500">Build</a>
          <a href="#coach" class="transition hover:text-red-500">Coach</a>
          <a href="#contact" class="transition hover:text-red-500">Contact</a>
          <a href="#sponsors" class="transition hover:text-red-500">Sponsors</a>
        </nav>
      </div>
    </header>

    <main id="top">
      <section class="relative isolate overflow-hidden bg-[#050505] text-white">
        <div class="absolute inset-0 -z-10">
          <img
            src="/huddle3-crop.jpeg"
            alt="Football team huddled on the field at sunset"
            class="h-full w-full scale-110 object-cover object-center brightness-60 contrast-110 saturate-75"
          />
          <div class="absolute inset-0 bg-[radial-gradient(circle_at_20%_30%,rgba(220,38,38,0.18),transparent_28%)]"></div>
          <div class="absolute inset-0 bg-gradient-to-r from-[#050505] via-[#050505]/85 via-[58%] to-[#050505]/15"></div>
        </div>

        <div class="mx-auto grid min-h-[82vh] max-w-7xl lg:grid-cols-[0.95fr_1.05fr]">
          <div class="relative z-10 flex items-center justify-center bg-[#050505]/90 px-6 py-16 sm:px-10 lg:px-12 lg:py-20 lg:bg-[#050505]">
            <div class="w-full max-w-xl">
              <div class="mb-8 w-full">
                <img
                  src="/FFF-logo.jpeg"
                  alt="Faith Family Football logo"
                  class="mx-auto block h-auto w-full max-w-md object-contain sm:max-w-lg"
                />
              </div>

              <p class="mb-4 text-sm font-semibold uppercase tracking-[0.35em] text-red-500">
                Southwest Virginia ministry • youth leadership
              </p>

              <h1 class="text-5xl font-black uppercase leading-none tracking-tight text-white sm:text-6xl lg:text-7xl">
                Faith!<br /> Family!<br /> Football!
              </h1>

              <p class="mt-6 max-w-xl text-lg leading-8 text-slate-200 sm:text-xl">
                Building character, faith, and community on and off the field
                through mentorship, discipline, and heart.
              </p>

              <div class="mt-8 flex flex-wrap gap-4">
                <a
                  href="#contact"
                  class="rounded-full bg-red-700 px-6 py-3 text-sm font-semibold uppercase tracking-[0.2em] text-white transition hover:bg-red-600"
                >
                  Get Involved
                </a>
                <a
                  href="#build"
                  class="rounded-full border border-white/30 bg-white/5 px-6 py-3 text-sm font-semibold uppercase tracking-[0.2em] text-white transition hover:bg-white/10"
                >
                  Explore Our Mission
                </a>
              </div>
            </div>
          </div>

          <div class="hidden lg:block"></div>
        </div>
      </section>

      <section id="about" class="mx-auto max-w-7xl px-6 py-20 lg:px-8">
        <div class="grid gap-8 lg:grid-cols-[0.85fr_1.15fr] lg:items-center">
          <div>
            <p
              class="text-sm font-semibold uppercase tracking-[0.35em] text-red-700"
            >
              About
            </p>
            <h2
              class="mt-3 text-3xl font-black uppercase tracking-tight text-slate-950 sm:text-4xl"
            >
              A ministry rooted in service, strength, and unity.
            </h2>
          </div>
          <div
            class="rounded-3xl border border-slate-200 bg-white p-8 shadow-sm"
          >
            <p class="text-lg leading-8 text-slate-700">
              Faith Family Football Ministry exists to help youth grow into
              disciplined, compassionate leaders. Through football, mentorship,
              and faith-based encouragement, we create a welcoming environment
              where families feel supported and athletes learn to compete with
              integrity.
            </p>
          </div>
        </div>
      </section>

      <section id="build" class="relative overflow-hidden bg-slate-950 py-20 text-white">
        <div class="absolute inset-0 bg-[radial-gradient(circle_at_top,_rgba(200,16,46,0.22),_transparent_45%)]"></div>
        <div class="relative mx-auto max-w-6xl px-6 lg:px-8">
          <div class="overflow-hidden rounded-[2rem] border border-yellow-500/30 bg-slate-950/75 shadow-2xl backdrop-blur-sm">
            <img
              src="/theme-2026.png"
              alt="2026 Season Theme - Faith. Family. Football."
              class="w-full h-auto object-cover"
            />
          </div>
        </div>
      </section>

      <section id="coach" class="mx-auto max-w-7xl px-6 py-20 lg:px-8">
        <div
          class="grid gap-8 rounded-[2rem] border border-slate-200 bg-white p-8 shadow-sm lg:grid-cols-[1fr_1fr] lg:p-12"
        >
          <div class="grid gap-4 sm:grid-cols-1">
            <img
              src="/coach.jpeg"
              alt="Coach portrait in black and white"
              class="h-72 w-full rounded-2xl object-cover sm:h-80 lg:h-96"
            />
          </div>
          <div class="flex flex-col justify-center">
            <p
              class="text-sm font-semibold uppercase tracking-[0.35em] text-red-700"
            >
              Coach Spotlight
            </p>
            <h2
              class="mt-3 text-3xl font-black uppercase tracking-tight text-slate-950 sm:text-4xl"
            >
              A leader focused on heart, growth, and guidance.
            </h2>
            <p class="mt-6 text-lg leading-8 text-slate-700">
              Coach brings a heart for youth, a deep love for the game, and a
              mission to shape young people through discipline, compassion, and
              bold leadership. Our ministry exists to help every player see
              their value both on and off the field.
            </p>
            <div class="mt-8 flex flex-wrap gap-4">
              <a
                href="#contact"
                class="rounded-full bg-red-700 px-6 py-3 text-sm font-semibold uppercase tracking-[0.2em] text-white transition hover:bg-red-600"
              >
                Connect With Us
              </a>
            </div>
          </div>
        </div>
      </section>
    </main>

    <footer
      id="contact"
      class="border-t border-slate-200 bg-slate-950 py-16 text-white"
    >
      <div
        class="mx-auto grid max-w-7xl gap-10 px-6 lg:grid-cols-[1fr_0.8fr] lg:px-8"
      >
        <div>
          <p
            class="text-sm font-semibold uppercase tracking-[0.35em] text-red-400"
          >
            Contact
          </p>
          <h2
            class="mt-3 text-3xl font-black uppercase tracking-tight sm:text-4xl"
          >
            Let’s build something strong together.
          </h2>
          <p class="mt-5 max-w-2xl text-lg leading-8 text-slate-300">
            Whether you are a parent, coach, church leader, or community
            partner, we would love to hear from you.
          </p>
        </div>
        <div
          class="rounded-3xl border border-white/10 bg-white/10 p-8 backdrop-blur"
        >
          <ul class="space-y-4 text-base text-slate-200">
            <li>
              <span class="font-semibold text-white">Email:</span> silent_e02@hotmail.com
            </li>
            <li>
              <span class="font-semibold text-white">Phone:</span> 276-701-3625
            </li>
            <!-- <li>
              <span class="font-semibold text-white">Social:</span> @faithfamilyfootballva
            </li> -->
          </ul>
        </div>
      </div>
    </footer>

    <section id="sponsors" class="bg-slate-50 py-16 text-slate-900">
      <div class="mx-auto max-w-5xl px-6 lg:px-8">
        <div class="mb-10 text-center">
          <p class="text-sm font-semibold uppercase tracking-[0.35em] text-red-700">
            Sponsor Spotlight
          </p>
          <h2 class="mt-3 text-3xl font-black uppercase tracking-tight sm:text-4xl">
            Thank You To Our Supporters
          </h2>
        </div>

        <div class="flex justify-center">
          <div class="w-full max-w-3xl rounded-[2rem] border border-slate-200 bg-white p-8 shadow-sm sm:p-10">
            <div class="flex items-center justify-center rounded-2xl bg-slate-100 p-6">
              <img
                src="/new-peoples-logo.svg"
                alt="New Peoples Bank logo"
                class="max-h-24 w-full max-w-md object-contain"
              />
            </div>

            <div class="mt-8 border-t border-slate-200 pt-6">
              <p class="text-center text-xs font-bold uppercase tracking-[0.35em] text-slate-500">
                Individual Supporters
              </p>
              <div class="mt-5 flex flex-wrap items-center justify-center gap-x-8 gap-y-3 text-center text-base font-semibold text-slate-700 sm:text-lg">
                <span>Curry Family</span>
                <span>Anonymous Sponsors</span>

              </div>
            </div>
          </div>
        </div>

        <p class="mt-10 text-center text-sm font-medium uppercase tracking-[0.25em] text-slate-600">
          Made by <a href="https://ericblankenship.dev" class="text-red-700 hover:underline">Eric Blankenship</a>
        </p>
        <p class="mt-6 text-center text-sm text-slate-500">
          © 2026 faithfamilyfootballva.com
        </p>
      </div>
    </section>
  </body>
</html>
